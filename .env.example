# Anthropic Claude（必填，如使用 Anthropic 模型）
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI（可选，如使用 OpenAI 模型）
OPENAI_API_KEY=sk-...

# Google（可选，如使用 Gemini 模型）
GOOGLE_API_KEY=AIza...

# 配置目录路径（可选，支持绝对路径或相对路径，默认从包位置自动推导）
# 未设置时自动定位到项目根目录下的 configs/，通常无需配置
# SUNDAY_CONFIGS_DIR=/path/to/configs

# 日志级别（可选，默认 INFO）
# SUNDAY_LOG_LEVEL=INFO
